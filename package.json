{
  "author": {
    "email": "milev.stefan@gmail.com",
    "name": "Delemangi",
    "url": "https://delemangi.com"
  },
  "bugs": {
    "url": "https://github.com/Delemangi/eslint-config-imperium/issues"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.28.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-no-barrel-files": "^2.3.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-solid": "^0.18.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "svelte": "^5.57.2",
    "typescript-eslint": "^8.72.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "description": "Comprehensive ESLint configuration",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "react": "^19.3.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24 || ^26"
  },
  "files": [
    "lib",
    "!lib/test"
  ],
  "homepage": "https://github.com/Delemangi/eslint-config-imperium",
  "keywords": [
    "eslint",
    "eslint-config",
    "imperium",
    "typescript"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "name": "eslint-config-imperium",
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delemangi/eslint-config-imperium.git"
  },
  "scripts": {
    "build": "rimraf lib && tsc",
    "check": "tsc --noEmit",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "format": "eslint --ignore-pattern \"**/test/cases/*\" --fix .",
    "format:dev": "npm run build && npm run format",
    "lint": "eslint . --ignore-pattern \"**/test/cases/*\" --no-warn-ignored --cache",
    "lint:dev": "npm run build && npm run lint",
    "package": "npm run build && npm pack",
    "prepare": "husky",
    "release": "npm run build && semantic-release",
    "release:dry": "npm run build && npm run release -- --dry-run",
    "test": "vitest run --exclude lib",
    "test:consumer": "node scripts/test-consumer.js"
  },
  "type": "module",
  "types": "lib/index.d.ts",
  "version": "0.0.0"
}
